  GROUP BY
    c.customer_id, c.company_name
)

SELECT *,
  CASE
    WHEN num_orders >= 10 AND total_spent >= 1000 THEN 'High Value'
    WHEN num_orders >= 5 THEN 'Mid Value'
    ELSE 'Low Value'
  END AS customer_segment
FROM customer_segmentation;
